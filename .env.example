ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# "anthropic" (padrão), "ollama" ou "openrouter" — ver
# agents/llm.py::build_chat_model. Papéis que dependem de recursos
# exclusivos da Anthropic (ex.: o pesquisador, que usa a tool server-side
# web_search) ignoram esta config de propósito e ficam sempre em
# "anthropic".
LLM_PROVIDER=anthropic

# Só usados quando LLM_PROVIDER=ollama. Com docker-compose.yml (serviço
# "ollama"), o valor abaixo já é o correto; rodando o Ollama direto na
# máquina (fora do Docker) o padrão também funciona sem mudar nada.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Só usados quando LLM_PROVIDER=openrouter — chave em
# https://openrouter.ai/keys. OPENROUTER_MODEL aceita qualquer modelo do
# catálogo deles (inclusive opções gratuitas, sufixo ":free") — o padrão
# abaixo aponta pro Claude Haiku 4.5 via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
