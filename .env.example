ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# Opcional — só necessário se LLM_PROVIDER=deepseek (ver agents/llm.py).
LLM_PROVIDER=
DEEPSEEK_API_KEY=

# Obrigatório para agents/researcher.py (o "Pesquisador"): busca web real
# via TavilySearch — funciona com qualquer LLM_PROVIDER (Anthropic ou
# DeepSeek), diferente da antiga tool web_search nativa da Anthropic que
# este papel usava antes. Sem esta chave, o Pesquisador falha ao montar a
# tool de busca. Tem plano gratuito: https://app.tavily.com
TAVILY_API_KEY=

# Opcional — aponta a sandbox de write_file/read_file/list_dir/run_command
# (ver agents/tools.py) pra uma pasta real em vez do workspace/ descartável
# padrão. Lido uma única vez, na importação — reinicie o processo pra
# trocar. Exemplo: apontar pra pasta que tem todos os seus projetos, pra
# um agente poder trabalhar em qualquer um deles quando a tarefa pedir.
DEV_AGENT_WORKSPACE=
